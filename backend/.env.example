ENVIRONMENT=development
MODEL_PATH=models/EURUSD_M5_scalper.ubj
CORS_ORIGINS=http://localhost:5173

# Para pruebas locales puede ser false. En producción use true.
AUTH_REQUIRED=false
FIRESTORE_ENABLED=false

# Al activar Firebase, defina la ruta al JSON de una cuenta de servicio.
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\firebase-service-account.json

SIGNAL_THRESHOLD=0.68
MINIMUM_ATR=0.0005

# Cree el bot con BotFather. Nunca suba el token real al repositorio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_REJECTED=true
